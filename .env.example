# Copy this file to .env.local and fill in the values you need.
# None of these are required for the site to run locally - without them,
# contact form submissions are simply logged to the server console.

# Public base URL used for SEO metadata, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.manxqualitysheds.com

# --- Contact form email delivery (optional) ---
# Option A: Resend (https://resend.com)
# If both of these are set, quote enquiries (including image attachments)
# are sent via the Resend API.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Where enquiries should be delivered. Defaults to the business email
# configured in src/lib/site-config.ts if not set.
CONTACT_TO_EMAIL=

# Option B: Generic webhook (Zapier, Make, Formspree-compatible endpoint, etc.)
# If set (and Resend is not configured), form data is POSTed here as JSON.
CONTACT_FORM_WEBHOOK_URL=
